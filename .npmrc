# expo-router's web support pulls react-dom@19.2.x (via vaul/radix) whose peer
# wants a newer react than SDK 56 pins (react 19.2.3). That web-only chain is
# unused by the native app, but npm's strict peer check fails `npm ci` on EAS.
# Use legacy peer resolution so the install matches the committed lockfile.
legacy-peer-deps=true
